# ---- Local model runtime (no hosted LLM APIs) ----
# ollama | lmstudio (any local OpenAI-compatible server, e.g. llama.cpp server, LocalAI)
LOCAL_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Leave blank to auto-select from `ollama list` (vision: qwen2.5vl:7b if present)
OLLAMA_MODEL=
OLLAMA_VISION_MODEL=
# true: the vision model also handles text (3-5x faster on an 8GB GPU, no model swapping).
# false: use a separate text model (qwen3:14b) - slower, sometimes better on long/complex minutes.
OLLAMA_SINGLE_MODEL=true
# Upper bound; the app picks the smallest of 4096/8192/16384 that fits each request (faster on small GPUs)
OLLAMA_NUM_CTX=16384
# Unload the previous model when switching text<->vision (needed on 16GB RAM machines)
OLLAMA_UNLOAD_ON_SWITCH=true
OLLAMA_KEEP_ALIVE=5m

# LM Studio / OpenAI-compatible LOCAL endpoint (only used when LOCAL_AI_PROVIDER=lmstudio)
LOCAL_AI_BASE_URL=http://localhost:1234/v1
LOCAL_AI_MODEL=
LOCAL_AI_VISION_MODEL=

# Local OCR (tesseract.js). Set to false to disable.
OCR_ENABLED=true

# ---- Cloudinary (server-signed uploads; secret stays on the server) ----
# Leave blank to store images on local disk instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Inbox watcher: photos uploaded to <folder>/<workspace-slug> are imported + analyzed automatically
CLOUDINARY_INBOX=true
CLOUDINARY_INBOX_FOLDER=orgmap-inbox
CLOUDINARY_INBOX_POLL_SECONDS=15

PORT=8787
