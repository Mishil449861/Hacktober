# Secrets for the hosted demo on Streamlit Community Cloud.
# Paste these (with your values) into: share.streamlit.io > your app > Settings > Secrets.
# Never commit a real secrets.toml (it is git-ignored).

# The page starts the OrgMap server itself and asks each visitor for their own AI key.
ORGMAP_HOSTED = "true"

# Your Cloudinary account (console > Settings > API Keys): stores visitors' photos, makes the
# copy the AI reads, and keeps a private backup of the boards so they survive the app restarting.
CLOUDINARY_CLOUD_NAME = "your-cloud-name"
CLOUDINARY_API_KEY = "123456789012345"
CLOUDINARY_API_SECRET = "your-api-secret"

# Optional: delete boards nobody touched for this many days (default 30).
# BOARD_MAX_AGE_DAYS = "30"
