# ---- dependencies ----
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# ---- build output ----
dist/
dist-ssr/
*.tsbuildinfo

# ---- secrets (never commit credentials) ----
.env
.env.*
!.env.example

# ---- local runtime data ----
# workspace database, local image uploads, OCR language cache
data/
# isolated servers used by the eval / scenario tests
data-eval/
data-exp/
# eval reports (regenerated by `npm run test:eval`)
tests/results/

# ---- logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- editors / OS ----
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# ---- Claude Code local settings ----
.claude/settings.local.json
