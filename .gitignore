# ---- dependencies ----
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# ---- build output ----
dist/
dist-ssr/
*.tsbuildinfo

# ---- secrets (never commit credentials) ----
.env
.env.*
!.env.example

# ---- local runtime data ----
# workspace database, local image uploads, OCR language cache
data/
# isolated servers used by the eval / scenario tests
data-eval/
data-exp/
data-hosted-test/
# eval reports (regenerated by `npm run test:eval`)
tests/results/

# ---- logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- editors / OS ----
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# ---- local tool settings (per-machine command approvals) ----
.claude/

# generated by deploy/windows/install-keep-alive.ps1 (contains this machine's path)
deploy/windows/keep-alive-hidden.vbs

# Streamlit secrets (Cloudinary keys etc.): set them in the Streamlit Cloud app settings, never commit them
.streamlit/secrets.toml
